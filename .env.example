# Copy values into the Windows service environment; this app does not load .env files.
# Generate a private 32-byte random value encoded as 64 hex characters. Never commit it.
ALFRED_API_TOKEN=
# Default permissions. Add ,delete only when enabling confirmed destructive tools.
ALFRED_API_SCOPES=read,write
# Existing production settings, unchanged:
PORT=3002
BASE_PATH=/todo
